{
  "name": "spaci-web",
  "private": true,
  "version": "2.3.0",
  "type": "module",
  "description": "Spaci marketing site, changelog and update feed. Built by kentom.co.ke.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite dev",
    "prebuild": "tsx scripts/refresh-baseline.ts",
    "build": "vite build",
    "refresh:baseline": "tsx scripts/refresh-baseline.ts",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:releases": "tsx scripts/check-releases.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm run check:releases && npm test && npm run check && npm run build",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "^5.4.0",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^3.1.0",
    "@types/node": "^20.19.43",
    "prisma": "^5.20.0",
    "svelte": "^4.2.18",
    "svelte-check": "^3.8.0",
    "tslib": "^2.6.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "marked": "^18.0.14"
  }
}
