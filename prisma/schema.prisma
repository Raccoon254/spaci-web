// Prisma schema for the Spaci web backend.
//
// The static src/lib/releases.ts stays the canonical list rendered on the site.
// This database mirrors that data (via prisma/seed.ts and the POST /api/releases
// publish hook) so the dynamic endpoints can serve and analyse it.
//
// IMPORTANT: Spaci shares the kentom.co.ke Neon database with the stevetom
// portfolio, so every model lives in its OWN Postgres schema ("spaci"), NOT in
// "public". This keeps `prisma db push` scoped to the spaci schema and means it
// can never see, alter or drop the portfolio's tables in the public schema.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["spaci"]
}

model Release {
  id        String        @id @default(cuid())
  version   String        @unique
  date      DateTime
  tag       String
  major     Boolean       @default(false)
  summary   String
  added     String[]
  improved  String[]
  fixed     String[]
  createdAt DateTime      @default(now())
  files     ReleaseFile[]
  // Rich release notes (all optional, nullable so existing rows stay valid).
  // highlight: one-line plain-text message (<= 160 chars).
  // notes: raw Markdown, converted to blocks on read by src/lib/blocks.ts.
  // media: [{ url, alt, caption? }], allowlisted https images only.
  // links: [{ label, url }], https only.
  highlight String?
  notes     String?
  media     Json?
  links     Json?

  @@schema("spaci")
}

model ReleaseFile {
  id        String  @id @default(cuid())
  platform  String
  arch      String
  file      String
  size      String
  bytes     Int
  sha512    String  @default("")
  release   Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  releaseId String

  @@index([releaseId])
  @@schema("spaci")
}

// Release-announcement signups ("notify me on new releases").
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  confirmed Boolean  @default(false)

  @@schema("spaci")
}

// Simple download analytics, one row per installer download.
model DownloadEvent {
  id       String   @id @default(cuid())
  version  String
  platform String
  file     String
  // "install" (.dmg, Windows setup .exe, .AppImage) or "update" (mac .zip).
  // Nullable so rows written before this field existed stay valid.
  kind     String?
  at       DateTime @default(now())

  @@index([version])
  @@schema("spaci")
}

// Daily heartbeat, one row per (installHash, day). installHash is a salted
// SHA-256 of the random install ID the app generates; the raw ID is never stored.
// No IP address, user agent, path or file name is ever kept here.
model DailyActive {
  id          String   @id @default(cuid())
  installHash String
  day         DateTime @db.Date
  version     String
  platform    String
  arch        String
  // When this install was first seen (same value on every row of an install).
  firstSeen   DateTime

  @@unique([installHash, day])
  @@index([day])
  @@schema("spaci")
}

// Daily snapshot of GitHub's release asset download_count (authoritative for
// direct GitHub downloads). Cumulative counts; deltas are computed on read.
model GithubDownloadSnapshot {
  id    String   @id @default(cuid())
  day   DateTime @db.Date
  tag   String
  asset String
  count Int

  @@unique([day, tag, asset])
  @@index([day])
  @@schema("spaci")
}

// In-app notices shown by the desktop app (GET /api/notices) and managed at
// /admin/notices. `body` is raw Markdown, converted to blocks on read by
// src/lib/blocks.ts (the security boundary). A 'release' notice is created by
// POST /api/releases; @@unique([kind, version]) makes that upsert idempotent
// (announcements have a null version, and Postgres allows many NULLs).
model Notice {
  id          String    @id @default(cuid())
  kind        String    @default("announcement") // release | announcement
  severity    String    @default("info") // info | update | important | critical
  title       String
  summary     String    @default("")
  body        String    @default("")
  media       Json?
  ctaLabel    String?
  ctaUrl      String?
  version     String?
  // Audience: empty platforms means every platform; version bounds inclusive.
  platforms   String[]
  minVersion  String?
  maxVersion  String?
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  dismissible Boolean   @default(true)
  publishedAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([kind, version])
  @@index([startsAt])
  @@schema("spaci")
}
